# Virtual environment -- not portable across machines, recreate on each one
.venv/

# Runtime data: corpus PDFs and the vector index built from them both
# contain real internal company documents (signed contracts, employee
# health data) -- never goes to a third-party host, even private. Moves
# via external drive only (see MIGRATION.md).
data/

# Same reason: this transcript quotes real document content throughout.
claude_session_archive/

# Same reason: rendered page images and extracted text from real corpus
# files used by testing/ scripts -- the scripts themselves are code and stay
# tracked, but their output is real internal document content.
result/

# Python
__pycache__/
*.pyc

# Streamlit local secrets (if ever added)
.streamlit/secrets.toml

# OS noise
Thumbs.db
.DS_Store

# Claude Code's own local tooling state, not project code
.claude/
