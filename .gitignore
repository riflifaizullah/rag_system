# Virtual environment -- not portable across machines, recreate on each one
.venv/

# Runtime data: corpus PDFs and the vector index built from them both
# contain real internal company documents (signed contracts, employee
# health data) -- never goes to a third-party host, even private. Moves
# via external drive only (see MIGRATION.md).
data/

# Same reason: this transcript quotes real document content throughout.
claude_session_archive/

# Same reason: rendered page images and extracted text from real corpus
# files used by testing/ scripts.
result/

# Same reason, caught later: these scripts hardcode real internal document
# filenames and descriptions as literal strings (e.g. signed contracts,
# a named employee's COVID-test letter) to pick a varied sample to test
# against -- the code logic is fine to share, but the filenames/comments
# are themselves real document content, not just code.
backend/testing/

# Python
__pycache__/
*.pyc

# Streamlit local secrets (if ever added)
.streamlit/secrets.toml

# OS noise
Thumbs.db
.DS_Store

# Claude Code's own local tooling state, not project code
.claude/

# graphify's generated knowledge graph + extraction cache -- fully
# regenerable with `/graphify --update`, same reasoning as .NET's bin/obj
# below: a build artifact, not a source file.
graphify-out/

# .NET build output -- regenerate with `dotnet build`, never hand-edited.
**/bin/
**/obj/

# Visual Studio / Rider per-user workspace state, not project config.
.vs/
*.user
*.suo

# Stray console redirects from `dotnet run > ...log` landing in the project
# folder instead of a scratch dir -- not project output, safe to delete.
dotnet/RagSystemWeb/*.log

# Internal running log / handoff scratchpad, not meant for the shared repo.
NOTES.md

# Test/eval/maintenance tooling, kept local only -- not needed to run the
# app itself (that's api.py, config.py, database.py, generation.py,
# ingestion.py, retrieval.py, sync_documents.py). Results already live in
# EVALUATION_RESULTS.md; the scripts/raw data that produced them stay here,
# same reasoning as backend/testing/ and backend/result/ above.
backend/app/build_eval_questions.py
backend/app/evaluate_grounded.py
backend/app/test_units.py
backend/app/test_extraction.py
backend/app/check_corpus_integrity.py
backend/app/dump_chunks.py
backend/app/reingest.py
backend/app/reset_index.py
backend/app/corpus_generator/generate.py
